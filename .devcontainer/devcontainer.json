{
  "name": "microservices-python",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker", "charliermarsh.ruff"]
    }
  },
  "postCreateCommand": "cp -n .env.example .env || true",
  "forwardPorts": [8000, 8002, 8004, 15672]
}
