# Copiez ce fichier en .env puis ajustez si besoin :  cp .env.example .env
# (le fichier .env n'est jamais versionné)

POSTGRES_PASSWORD=devpass

VEHICULES_DATABASE_URL=postgresql+asyncpg://app:devpass@db-vehicules:5432/vehicules
LOCATIONS_DATABASE_URL=postgresql+asyncpg://app:devpass@db-locations:5432/locations
AUTH_DATABASE_URL=postgresql+asyncpg://app:devpass@db-auth:5432/auth

RABBITMQ_URL=amqp://guest:guest@rabbitmq/

# TP8 — secret de signature des JWT (changez cette valeur !)
JWT_SECRET=changez-moi-en-seance-8
